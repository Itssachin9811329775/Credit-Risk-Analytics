            "name": "Credit Limit in Selected History Cohort NTD",
            "displayFolder": "Report measures",
            "expression": [
              "VAR CohortIDs = VALUES(monthly_repayments[customer_id])",
              "RETURN",
              "    CALCULATE(",
              "        [Credit Limit NTD],",
              "        KEEPFILTERS(TREATAS(CohortIDs, customers[customer_id]))",
              "    )"
            ],
