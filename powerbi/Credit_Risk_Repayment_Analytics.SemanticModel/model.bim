        "measures": [
          {
            "name": "Customer Count",
            "displayFolder": "Report measures",
            "expression": "COUNTROWS(customers)",
            "formatString": "#,0",
            "lineageTag": "e84a4830-90f4-4327-8256-432d8a806566"
          },
          {
            "name": "Outcome Customers",
            "displayFolder": "Report measures",
            "expression": "COUNTROWS(default_outcomes)",
            "formatString": "#,0",
            "lineageTag": "7d6f1eb7-c183-4824-af2f-6381bd929781"
          },
          {
            "name": "Defaulting Customers",
            "displayFolder": "Report measures",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(default_outcomes),",
              "    KEEPFILTERS(default_outcomes[default_next_month] = 1)",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "f02eb5c0-cde2-47ea-96b5-c898921ecbdb"
          },
          {
            "name": "Default Rate",
            "displayFolder": "Report measures",
            "expression": "DIVIDE([Defaulting Customers], [Outcome Customers])",
            "formatString": "0.00%",
            "lineageTag": "e202bf1c-34b7-4f02-afa4-719fa1192d04"
          },
          {
            "name": "Credit Limit NTD",
            "displayFolder": "Report measures",
            "expression": "SUM(customers[credit_limit_ntd])",
            "formatString": "#,0",
            "lineageTag": "45340eec-1534-4715-a2bd-1dbc70a7f76a"
          },
          {
            "name": "Monthly Rows",
            "displayFolder": "Report measures",
            "expression": "COUNTROWS(monthly_repayments)",
            "formatString": "#,0",
            "lineageTag": "0431d069-a871-48ac-bc6c-dd89f0aaaa4e"
          },
          {
            "name": "Monthly Customers",
            "displayFolder": "Report measures",
            "expression": "DISTINCTCOUNT(monthly_repayments[customer_id])",
            "formatString": "#,0",
            "lineageTag": "7fa1b24a-3ee6-4943-acdb-1eea9b9ed739"
          },
          {
            "name": "Documented Delay Rows",
            "displayFolder": "Report measures",
            "expression": [
              "CALCULATE(",
              "    [Monthly Rows],",
              "    KEEPFILTERS(monthly_repayments[repayment_status] >= 1)",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "5fc9f2c3-23de-4db5-aec8-c35bf3683a1c"
          },
          {
            "name": "Documented Delay Share",
            "displayFolder": "Report measures",
            "expression": "DIVIDE([Documented Delay Rows], [Monthly Rows])",
            "formatString": "0.00%",
            "lineageTag": "265aa184-f245-4cee-8fdd-318ce3de4cd3"
          },
          {
            "name": "Undocumented Status Rows",
            "displayFolder": "Report measures",
            "expression": [
              "CALCULATE(",
              "    [Monthly Rows],",
              "    KEEPFILTERS(monthly_repayments[repayment_status] IN {-2, 0})",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "af8aacb5-824f-43da-b66f-66533faec524"
          },
          {
            "name": "Undocumented Status Share",
            "displayFolder": "Report measures",
            "expression": "DIVIDE([Undocumented Status Rows], [Monthly Rows])",
            "formatString": "0.00%",
            "lineageTag": "1a3658ff-2554-44b6-afce-ca103aef8a68"
          },
          {
            "name": "Recorded Payments NTD",
            "displayFolder": "Report measures",
            "expression": "SUM(monthly_repayments[payment_amount_ntd])",
            "formatString": "#,0",
            "lineageTag": "bd862d12-a9b9-4a89-a2c5-4e30df2ed3f9"
          },
          {
            "name": "Single Month Bill NTD",
            "displayFolder": "Report measures",
            "expression": [
              "IF(",
              "    HASONEVALUE(calendar_months[month_start]),",
              "    SUM(monthly_repayments[bill_amount_ntd]),",
              "    BLANK()",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "0f24fe11-8411-4ba6-a5ca-469a02a43618"
          },
          {
            "name": "Negative Bill Rows",
            "displayFolder": "Report measures",
            "expression": [
              "CALCULATE(",
              "    [Monthly Rows],",
              "    KEEPFILTERS(monthly_repayments[bill_amount_ntd] < 0)",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "5071c6a3-5121-407b-937f-e3ba2d3e63ea"
          },
          {
            "name": "Selected History Customers",
            "displayFolder": "Report measures",
            "expression": "COUNTROWS(VALUES(monthly_repayments[customer_id]))",
            "formatString": "#,0",
            "lineageTag": "beb5f7b9-13b7-4209-b9cc-e5eb3aeed726"
          },
          {
            "name": "Defaults in Selected History Cohort",
            "displayFolder": "Report measures",
            "expression": [
              "VAR CohortIDs = VALUES(monthly_repayments[customer_id])",
              "RETURN",
              "    CALCULATE(",
              "        [Defaulting Customers],",
              "        KEEPFILTERS(TREATAS(CohortIDs, default_outcomes[customer_id]))",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "6ca0773c-1195-46e3-9de9-dec6047eb2fe"
          },
          {
            "name": "Selected History Cohort Default Rate",
            "displayFolder": "Report measures",
            "expression": "DIVIDE([Defaults in Selected History Cohort], [Selected History Customers])",
            "formatString": "0.00%",
            "lineageTag": "0635730e-90d3-4be5-883f-29a9f4bd6fe1"
